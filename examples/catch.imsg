# Catch: move the paddle to catch the falling ball. A miss flashes the screen.
display 6 8
input LEFT hold
input RIGHT hold
state paddle 3 = 2
state ballx 3 = 1
state bally 3
state rng 5 = 21
state slow 1
state flash 2
tick
  rng = (rng << 1) | (((rng >> 4) ^ (rng >> 2)) & 1)
  if LEFT and paddle > 0
    paddle = paddle - 1
  elif RIGHT and paddle < 4
    paddle = paddle + 1
  end
  slow = not slow
  if flash > 0
    flash = flash - 1
  elif slow
    if bally < 7
      bally = bally + 1
    else
      if ballx != paddle and ballx != paddle + 1
        flash = 3
      end
      bally = 0
      ballx = rng & 3
      if rng[4]
        ballx = ballx + 2
      end
    end
  end
end
screen
  for i 0 5
    for j 0 7
      pixel i j = flash > 0 or (i == ballx and j == bally) or (j == 7 and (i == paddle or i == paddle + 1))
    end
  end
end
